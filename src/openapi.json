{
  "openapi": "3.0.0",
  "info": {
    "title": "TaskFlow API",
    "version": "1.0.0",
    "description": "A lightweight productivity web service with task management and Supabase Auth."
  },
  "servers": [
    { "url": "http://localhost:4000" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "done": { "type": "boolean" }
        }
      },
      "NewTask": {
        "type": "object",
        "required": ["title"],
        "properties": { "title": { "type": "string" } }
      },
      "SignupRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "API info",
        "responses": {
          "200": {
            "description": "API description",
            "content": {
              "application/json": {
                "example": { "name": "TaskFlow", "version": "1.0.0", "endpoints": ["/tasks", "/auth"] }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Server is alive",
            "content": {
              "application/json": { "example": { "status": "ok", "db": "ok" } }
            }
          }
        }
      }
    },
    "/public/info": {
      "get": {
        "summary": "Public app info (no auth required)",
        "responses": {
          "200": {
            "description": "Public info",
            "content": {
              "application/json": {
                "example": {
                  "appName": "TaskFlow",
                  "version": "1.0.0",
                  "message": "Welcome to TaskFlow! Sign up to organize your daily tasks.",
                  "totalUsers": 1250
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "Create a new user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SignupRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "example": { "user": { "id": "usr_123", "email": "alex@example.com" } }
              }
            }
          },
          "400": { "description": "Missing email or password" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate and receive JWT tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "example": { "access_token": "eyJ...", "refresh_token": "eyJ..." }
              }
            }
          },
          "400": { "description": "Missing fields" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "End the user session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Logged out" },
          "401": { "description": "Access token required" }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "Current user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "example": {
                  "id": "usr_987654321",
                  "email": "alex@example.com",
                  "created_at": "2026-03-01T10:00:00Z",
                  "profile": { "theme": "dark", "pendingTasks": 4 }
                }
              }
            }
          },
          "401": { "description": "Invalid or expired token" }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "summary": "User dashboard",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Dashboard data",
            "content": {
              "application/json": {
                "example": {
                  "userId": "usr_987654321",
                  "message": "This is your private dashboard",
                  "stats": { "tasksCompleted": 12, "currentStreak": 3 }
                }
              }
            }
          },
          "401": { "description": "Invalid or expired token" }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "List all tasks",
        "parameters": [
          { "name": "done", "in": "query", "schema": { "type": "boolean" }, "description": "Filter by completion status" },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search by title (case-insensitive)" }
        ],
        "responses": {
          "200": {
            "description": "Array of tasks",
            "content": {
              "application/json": {
                "example": [
                  { "id": 1, "title": "Buy groceries", "done": false },
                  { "id": 2, "title": "Walk the dog", "done": true }
                ]
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/NewTask" } }
          }
        },
        "responses": {
          "201": {
            "description": "Created task",
            "content": {
              "application/json": {
                "example": { "id": 4, "title": "Buy milk", "done": false }
              }
            }
          },
          "400": { "description": "Missing title" }
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
      ],
      "get": {
        "summary": "Get one task",
        "responses": {
          "200": {
            "description": "A task",
            "content": {
              "application/json": {
                "example": { "id": 1, "title": "Buy groceries", "done": false }
              }
            }
          },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "summary": "Update a task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Task" } }
          }
        },
        "responses": {
          "200": { "description": "Updated task" },
          "400": { "description": "Invalid body" },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "summary": "Delete a task",
        "responses": {
          "204": { "description": "Deleted (no content)" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/stats": {
      "get": {
        "summary": "Task statistics",
        "responses": {
          "200": {
            "description": "Task counts",
            "content": {
              "application/json": {
                "example": { "total": 3, "done": 1, "open": 2 }
              }
            }
          }
        }
      }
    },
    "/reset": {
      "post": {
        "summary": "Reset tasks to default seed data",
        "responses": {
          "201": {
            "description": "Reset successful",
            "content": {
              "application/json": {
                "example": { "message": "Tasks reset to defaults" }
              }
            }
          }
        }
      }
    }
  }
}
